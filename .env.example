# 复制为 .env 后填写：cp .env.example .env && chmod 600 .env
# 生成强密码：openssl rand -base64 24

# 必填（缺失时 docker compose 会直接报错，防止用默认弱密码上线）
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=

# 数据库名/用户名（保持 assaka_blog / assaka 才能让初始化 SQL 自动导入）
DB_NAME=assaka_blog
DB_USER=assaka

# 域名与证书邮箱（仅用于签发 Let's Encrypt 证书时参考）
DOMAIN=example.com
LETSENCRYPT_EMAIL=

# ICP 备案号：香港/海外服务器留空即可，留空则页面不显示页脚备案信息
ICP_BEIAN=
